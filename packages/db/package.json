{
  "name": "@project/db",
  "version": "0.0.1",
  "main": "./src/client.ts",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "db:bootstrap": "tsx prisma/bootstrap-cli.ts",
    "db:bootstrap:reset": "tsx ../../scripts/db-guard.ts db:bootstrap:reset && tsx prisma/bootstrap-cli.ts --reset",
    "db:bootstrap:check": "tsx prisma/bootstrap-cli.ts --check",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "generate": "prisma generate",
    "typecheck": "tsc --noEmit",
    "db:status": "dotenv -e ../../.env -- prisma migrate status",
    "db:reset": "dotenv -e ../../.env -- prisma migrate reset",
    "lint": "eslint src prisma",
    "assets:generate": "tsx scripts/generate-platform-assets.ts",
    "assets:covers": "tsx scripts/fetch-program-covers.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@prisma/client": "^5.0.0",
    "@project/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "prisma": "^5.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "dotenv-cli": "^7.4.0"
  }
}
