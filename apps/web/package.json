{
  "name": "web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:live": "E2E_LIVE=1 playwright test --project=live",
    "test:e2e:auth": "tsx scripts/auth-live.ts",
    "test:e2e:together": "tsx scripts/together-live.ts",
    "test:e2e:pwa": "playwright test --config playwright.pwa.config.ts"
  },
  "dependencies": {
    "@project/sdk": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "@tanstack/react-query": "^5.0.0",
    "sonner": "^2.0.8",
    "zod": "^4.6.7",
    "react-hook-form": "^7.54.0",
    "@hookform/resolvers": "^7.0.5",
    "lucide-react": "^1.72.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-react": "^6.3.0",
    "vite": "^8.3.8",
    "typescript": "^7.0.2",
    "tailwindcss": "^4.3.5",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "vitest": "^5.1.0",
    "vite-plugin-pwa": "2.0.0",
    "workbox-build": "7.4.1",
    "workbox-window": "7.4.1"
  }
}
