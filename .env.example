# Local development only. Never put production credentials here.
# On Railway, set DATABASE_URL on the server service to the MySQL service reference:
#   DATABASE_URL=${{MySQL.MYSQL_URL}}
DATABASE_URL=mysql://programs_app:change-me@127.0.0.1:3307/programs_app_dev
# Used only by `pnpm db:migrate` locally; that user must be able to create this database
SHADOW_DATABASE_URL=mysql://programs_app:change-me@127.0.0.1:3307/programs_app_shadow
# Server tests empty this database before every test: never point it at data you keep
TEST_DATABASE_URL=mysql://programs_app:change-me@127.0.0.1:3307/programs_app_test

# Server
PORT=3001
SESSION_SECRET=change-me-in-production
CORS_ORIGIN=http://localhost:5173
# Production: optional; leave unset for a host-only cookie on the API domain
COOKIE_DOMAIN=

# Web
VITE_API_URL=http://localhost:3001

# Feature flags
MARKETPLACE_ENABLED=false

# Public URLs (links in emails, signed media URLs, checkout returns)
PUBLIC_API_URL=http://localhost:3001
PUBLIC_APP_URL=http://localhost:5173
# Signing secrets. Development falls back to SESSION_SECRET. Production refuses to start unless each is
# a distinct random value of at least 32 characters (openssl rand -hex 32).
MEDIA_URL_SECRET=
EMAIL_LINK_SECRET=

# Storage: local (default, ./uploads) or r2. Production requires r2 (the API and worker do not share a disk).
STORAGE_PROVIDER=local
STORAGE_DIR=
# Rehearsals only: lets NODE_ENV=production use local storage
ALLOW_LOCAL_STORAGE=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Media limits and processing (defaults in apps/server/src/domains/media); ffmpeg/ffprobe from PATH by default
MEDIA_MAX_PHOTO_BYTES=
MEDIA_MAX_VIDEO_BYTES=
MEDIA_MAX_AUDIO_BYTES=
MEDIA_QUOTA_BYTES=
MEDIA_RETENTION_DAYS=
MEDIA_PROCESS_TIMEOUT_MS=
FFMPEG_PATH=
FFPROBE_PATH=
WORKER_TICK_MS=

# Email: capture (default, logs messages) or resend. The production worker requires resend.
EMAIL_PROVIDER=capture
RESEND_API_KEY=
EMAIL_FROM=

# Google sign-in (optional)
GOOGLE_CLIENT_ID=

# Billing (docs/adr/0001-billing-stripe-connect.md). Use a restricted key (rk_...) from a sandbox.
STRIPE_API_KEY=
# Older name for STRIPE_API_KEY, still read
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_THIN_WEBHOOK_SECRET=
PLATFORM_FEE_BPS=1000
STRIPE_AUTOMATIC_TAX=false
