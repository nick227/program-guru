{
  "name": "server",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "handlers:sync": "tsx scripts/sync-handlers.ts",
    "worker": "dotenv -e ../../.env -- tsx watch src/worker.ts",
    "dev:worker": "dotenv -e ../../.env -- tsx watch src/worker.ts",
    "start:worker": "node dist/worker.js",
    "bootstrap:prod": "node dist/bootstrap.js",
    "admin": "dotenv -e ../../.env -- tsx src/admin.ts",
    "admin:prod": "node dist/admin.js",
    "media:e2e": "tsx scripts/media-e2e.ts",
    "lint": "eslint src scripts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.1",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.3",
    "@prisma/client": "^7.10.1",
    "@project/db": "workspace:*",
    "@project/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.8",
    "fastify-openapi-glue": "^4.0.0",
    "google-auth-library": "^11.3.3",
    "js-yaml": "^5.5.0",
    "stripe": "^23.1.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/js-yaml": "^4.0.0",
    "@types/node": "^26.6.6",
    "ajv": "^8.0.0",
    "ajv-formats": "^3.0.0",
    "dotenv-cli": "^11.1.0",
    "esbuild": "~0.28.0",
    "tsx": "^4.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
