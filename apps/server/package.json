{
  "name": "server",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "handlers:sync": "tsx scripts/sync-handlers.ts",
    "worker": "dotenv -e ../../.env -- tsx watch src/worker.ts",
    "dev:worker": "dotenv -e ../../.env -- tsx watch src/worker.ts",
    "start:worker": "node dist/worker.js",
    "bootstrap:prod": "node dist/bootstrap.js",
    "media:e2e": "tsx scripts/media-e2e.ts",
    "lint": "eslint src scripts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@fastify/cookie": "^9.0.0",
    "@fastify/cors": "^9.0.0",
    "@fastify/rate-limit": "^9.0.0",
    "@fastify/swagger": "^8.0.0",
    "@fastify/swagger-ui": "^3.0.0",
    "@prisma/client": "^5.0.0",
    "@project/db": "workspace:*",
    "bcryptjs": "^2.4.3",
    "fastify": "^4.0.0",
    "fastify-openapi-glue": "^4.0.0",
    "google-auth-library": "^9.15.0",
    "js-yaml": "^4.0.0",
    "stripe": "^23.1.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^10.0.0",
    "@types/bcryptjs": "^2.4.0",
    "@types/js-yaml": "^4.0.0",
    "@types/node": "^20.0.0",
    "ajv": "^8.0.0",
    "ajv-formats": "^3.0.0",
    "dotenv-cli": "^7.4.0",
    "esbuild": "~0.28.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
