# Local development only. Never put production credentials here.
# On Railway, set DATABASE_URL on the server service to the MySQL service reference:
#   DATABASE_URL=${{MySQL.MYSQL_URL}}
DATABASE_URL=mysql://programs_app:change-me@127.0.0.1:3307/programs_app_dev
# Used only by `pnpm db:migrate` locally; that user must be able to create this database
SHADOW_DATABASE_URL=mysql://programs_app:change-me@127.0.0.1:3307/programs_app_shadow

# Server
PORT=3001
SESSION_SECRET=change-me-in-production
CORS_ORIGIN=http://localhost:5173

# Web
VITE_API_URL=http://localhost:3001

# Feature flags
MARKETPLACE_ENABLED=false
