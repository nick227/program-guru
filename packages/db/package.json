{
  "name": "@project/db",
  "version": "0.0.1",
  "main": "./src/client.ts",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "generate": "prisma generate",
    "typecheck": "tsc --noEmit",
    "db:status": "dotenv -e ../../.env -- prisma migrate status",
    "db:reset": "dotenv -e ../../.env -- prisma migrate reset",
    "lint": "eslint src prisma",
    "assets:generate": "tsx scripts/generate-platform-assets.ts",
    "assets:covers": "tsx scripts/fetch-program-covers.ts"
  },
  "dependencies": {
    "@prisma/client": "^7.10.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "prisma": "^7.10.1",
    "tsx": "^4.0.0",
    "typescript": "^7.0.2",
    "dotenv-cli": "^11.1.0"
  }
}
